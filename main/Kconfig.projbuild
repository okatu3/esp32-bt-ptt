menu "BT-PTT configuration"

    config BTPTT_DEVICE_NAME
        string "Bluetooth device name"
        default "BT-PTT"

    config BTPTT_PTT_GPIO
        int "PTT output GPIO (to the radio PTT interface)"
        range 0 33
        default 19
        help
            GPIO that drives the radio PTT through an opto-coupler or transistor.
            A1S AudioKit v2.2: IO19 on the 2x7 header (also wired to an on-board key).

    config BTPTT_PTT_ACTIVE_HIGH
        bool "PTT output is active high"
        default n
        help
            Off (default): ICOM handhelds. The pin is open-drain and pulls the
            radio MIC/PTT line to GND through ~33-47 kohm while transmitting,
            and floats while receiving.
            On: push-pull, high while transmitting (opto-coupler / transistor).

    config BTPTT_LED_GPIO
        int "TX indicator LED GPIO (-1 = none)"
        range -1 33
        default 22
        help
            A1S AudioKit v2.2: green LED on GPIO22, lit when the pin is low.

    config BTPTT_LED_ACTIVE_LOW
        bool "TX LED is lit when the pin is low"
        default y

    config BTPTT_KEY_GPIO
        int "Local PTT key GPIO (-1 = none)"
        range -1 39
        default 36
        help
            Push button on the board (active low). Short press toggles PTT,
            holding it for 3 s starts a headset search (pairing).
            A1S AudioKit v2.2: KEY1 = GPIO36.

    config BTPTT_TOT_DEFAULT_S
        int "Default TX time-out (seconds, 0 = off)"
        range 0 600
        default 180

endmenu
